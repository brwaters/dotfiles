#!/usr/bin/env python3
from openrgb import OpenRGBClient
from openrgb.utils import RGBColor
import time

ADDRESS = "127.0.0.1"
PORT = 6742

GPU_DEVICE = 0     # GPU device index
MB_DEVICE = 1      # motherboard device index
ARGB_ZONE = 3      # Aura Addressable 3 zone index
LED_COUNT = 90    # adjust to your strip length

MOBO_COLOR = RGBColor(0, 0, 255)
GPU_COLOR = RGBColor(0, 255, 0)

client = OpenRGBClient(address=ADDRESS, port=PORT,
                       name="hypr-init-openrgb-server")

mobo = client.devices[MB_DEVICE]

# Ensure we're in Direct mode
mobo.set_mode("Direct")

mobo_zone = mobo.zones[ARGB_ZONE]

# Resize the zone (this sends ResizeZone packet 1000)
mobo_zone.resize(LED_COUNT)

# Small delay to let controller apply size
time.sleep(0.25)

# Optional: set a colour to confirm it worked
mobo_zone.set_color(MOBO_COLOR)

gpu = client.devices[GPU_DEVICE]
gpu.set_mode("Direct")
time.sleep(0.25)
gpu.set_color(GPU_COLOR)

print("Zone resized and colour applied.")
