#!/bin/bash
set -euo pipefail

# Toggle the focused window between fully opaque and translucent (with blur
# behind it).
#
# Stock's omarchy-hyprland-window-transparency-toggle only flips the "opaque"
# prop, which drops a window back to its default opacity - 0.985 for
# terminals, so the toggle barely shows. Set the opacity directly instead.
#
# Pairs with the window rule that makes terminals fully opaque by default and
# blur.ignore_opacity = true (hyprland.lua), without which a runtime opacity
# change renders flat see-through with no blur.
TRANSLUCENT_OPACITY=0.65

addr=$(hyprctl activewindow -j | jq -r '.address // empty')
[[ -n $addr ]] || exit 0
window="address:$addr"

set_opacity() {
  for prop in opacity opacity_inactive; do
    hyprctl dispatch "hl.dsp.window.set_prop({ window = \"$window\", prop = \"$prop\", value = \"$1\" })" >/dev/null
  done
}

# Anything below 1 counts as translucent, so a window at a theme's default
# below-1 opacity goes opaque first.
if awk -v o="$(hyprctl getprop "$window" opacity)" 'BEGIN { exit !(o < 1) }'; then
  set_opacity 1.0
else
  set_opacity "$TRANSLUCENT_OPACITY"
fi
